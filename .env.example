# Application environment (public values only)
# Copy this file to .env.local and adjust the URLs for your environment.
# Never put Stripe secret keys or other server secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# API calls go to this app's own origin and are proxied to the Express server
# (see next.config.ts), so the auth cookie stays first-party.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Server-side only: where /api/v1 and /api/auth are proxied to.
API_PROXY_TARGET=http://localhost:5000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
